# ==============================================================================
# FLOW BACKEND - RENDER PRODUCTION ENVIRONMENT VARIABLES
# ==============================================================================
# Copy these values into: Render Dashboard > Services > flow-backend > Environment

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=production
APP_NAME=FLOW_BACKEND
# Render provides the port dynamically, but fallback is 4000
PORT=4000
# The public URL of your Render service once created (e.g. https://flow-backend.onrender.com)
APP_URL=https://flow-backend.onrender.com

# ------------------------------------------------------------------------------
# 2. CORS & FRONTEND (VERCEL INTEGRATION)
# ------------------------------------------------------------------------------
# Set FRONTEND_URL to your Vercel deployment URL
FRONTEND_URL=https://flow-frontend.vercel.app
# CORS allowed origins (JSON array string). Includes Vercel domains and local dev:
CORS_ORIGINS=["https://flow-frontend.vercel.app","https://*.vercel.app","http://localhost:3000"]

# ------------------------------------------------------------------------------
# 3. SUPABASE DATABASE & AUTHENTICATION
# ------------------------------------------------------------------------------
# Connect via Supabase Transaction/Session Pooler (Port 6543) for connection pooling:
DATABASE_URL=postgresql+asyncpg://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?ssl=require
DIRECT_URL=postgresql+asyncpg://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?ssl=require

SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=<YOUR-32-CHARACTER-MINIMUM-JWT-SECRET>
TOKEN_ENCRYPTION_KEY=<64-HEX-CHARACTER-SECRET-KEY>
SUPABASE_WEBHOOK_SECRET=whsec_your_supabase_secret

# ------------------------------------------------------------------------------
# 4. PART 1: CLOUDFLARE TUNNEL (LOCAL / GPU OLLAMA MODEL LAYER)
# ------------------------------------------------------------------------------
# Enter the HTTPS URL generated by Cloudflare Tunnel (Quick Tunnel or Named Domain)
# Example Quick Tunnel: https://your-tunnel-subdomain.trycloudflare.com
# Example Named Tunnel: https://models.yourdomain.com
OLLAMA_API_BASE=https://<YOUR-CLOUDFLARE-TUNNEL-URL>
LITELLM_BASE_URL=https://<YOUR-CLOUDFLARE-TUNNEL-URL>
LITELLM_MODEL=ollama/qwen3:8b
LITELLM_EMBEDDING_MODEL=ollama/nomic-embed-text
LITELLM_MASTER_KEY=sk-flow-local-dev
LITELLM_TIMEOUT_MS=30000
LITELLM_MAX_RETRIES=3

# ------------------------------------------------------------------------------
# 5. ZERO-TRUST EMAIL GATEWAY (GOOGLE APPS SCRIPT WEBHOOK)
# ------------------------------------------------------------------------------
APPSCRIPT_WEBHOOK_URL=https://script.google.com/macros/s/<DEPLOYMENT-ID>/exec
APPSCRIPT_SECRET_KEY=<YOUR-HMAC-SHA256-SECRET-KEY>

# ------------------------------------------------------------------------------
# 6. EMAIL FALLBACK & INBOUND (RESEND - OPTIONAL)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_secret

# ------------------------------------------------------------------------------
# 7. THIRD-PARTY INTEGRATIONS (OPTIONAL / PLACEHOLDER)
# ------------------------------------------------------------------------------
MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_CLIENT_SECRET=placeholder
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=https://flow-backend.onrender.com/api/v1/auth/callback/microsoft

GOOGLE_CLIENT_ID=placeholder
GOOGLE_CLIENT_SECRET=placeholder
GOOGLE_REDIRECT_URI=https://flow-backend.onrender.com/api/v1/auth/callback/google

