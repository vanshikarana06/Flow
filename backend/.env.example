# ==============================================================================
# 1. RENDER & APPLICATION RUNTIME
# ==============================================================================
NODE_ENV=production
PORT=4000
APP_NAME=FLOW_BACKEND
APP_URL=https://api.flow.dev
FRONTEND_URL=https://app.flow.dev
CORS_ORIGINS=https://app.flow.dev

# ==============================================================================
# 2. DATABASE & SUPABASE
# ==============================================================================
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?schema=public&sslmode=require
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-minimum-32-characters-length

# ==============================================================================
# 3. AUTHENTICATION & SECURITY ENCRYPTION
# ==============================================================================
TOKEN_ENCRYPTION_KEY=64-character-hex-encoded-aes-256-gcm-master-encryption-key
SUPABASE_WEBHOOK_SECRET=whsec_supabase_database_webhook_signing_secret_key

# ==============================================================================
# 4. MICROSOFT GRAPH API (AZURE ENTRA ID)
# ==============================================================================
MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_CLIENT_SECRET=azure-app-client-secret-value
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=https://api.flow.dev/api/auth/callback/microsoft
MICROSOFT_SCOPES=User.Read Mail.ReadWrite Mail.Send Calendars.ReadWrite Tasks.ReadWrite offline_access

# ==============================================================================
# 5. GOOGLE WORKSPACE APIS (GMAIL & GOOGLE CALENDAR)
# ==============================================================================
GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=google-client-secret-value
GOOGLE_REDIRECT_URI=https://api.flow.dev/api/auth/callback/google
GOOGLE_SCOPES=openid email profile https://www.googleapis.com/auth/gmail.modify https://www.googleapis.com/auth/gmail.send https://www.googleapis.com/auth/calendar

# ==============================================================================
# 6. LOCAL AI LAYER (LITELLM, OLLAMA, QWEN 2.5)
# ==============================================================================
LITELLM_BASE_URL=https://flow-ai-gateway.your-domain.cloudflareaccess.com
LITELLM_API_KEY=sk-litellm-service-master-key
LITELLM_MODEL=qwen2.5:7b-instruct
LITELLM_EMBEDDING_MODEL=text-embedding-nomic
LITELLM_TIMEOUT_MS=30000
LITELLM_MAX_RETRIES=3

# ==============================================================================
# 7. CLOUDFLARE TUNNEL
# ==============================================================================
CF_TUNNEL_SERVICE_TOKEN_ID=cf-access-service-client-id
CF_TUNNEL_SERVICE_TOKEN_SECRET=cf-access-service-client-secret
CF_TUNNEL_HOSTNAME=flow-ai-gateway.your-domain.cloudflareaccess.com

# ==============================================================================
# 8. RATE LIMITING & REDIS (RENDER INTEGRATION)
# ==============================================================================
REDIS_URL=redis://default:[PASSWORD]@[HOST].render.com:6379
THROTTLE_TTL=60
THROTTLE_LIMIT=120

