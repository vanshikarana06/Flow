# ==============================================================================
# FLOW MODEL LAYER (OLLAMA & LITELLM) ENVIRONMENT VARIABLES
# ==============================================================================
# Host this on your local GPU machine or cloud GPU instance (e.g. RunPod, Lambda)
# and expose it via Cloudflare Tunnel to Render.

# 1. Ollama Configuration
# Bind to all interfaces so cloudflared can proxy traffic
OLLAMA_HOST=0.0.0.0:11434
# Allow requests from any origin proxied by Cloudflare
OLLAMA_ORIGINS=*
# Keep models loaded in GPU VRAM (prevents cold reload latency)
OLLAMA_KEEP_ALIVE=24h
# Enable GPU acceleration
OLLAMA_NUM_PARALLEL=4

# 2. LiteLLM Proxy Configuration (Optional - if using LiteLLM proxy instead of direct Ollama)
LITELLM_MASTER_KEY=sk-flow-local-dev
LITELLM_MODEL=ollama/qwen3:8b
LITELLM_EMBEDDING_MODEL=ollama/nomic-embed-text
LITELLM_PORT=8000

# 3. Cloudflare Tunnel Configuration
# If using a Named Tunnel:
CLOUDFLARE_TUNNEL_NAME=flow-models-tunnel
CLOUDFLARE_TUNNEL_HOSTNAME=models.yourdomain.com

